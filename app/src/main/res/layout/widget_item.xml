<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Card background with rich translucent dark color matching app -->
    <ImageView
        android:id="@+id/widget_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_bg_neutral" />

    <!-- Item Content Container -->
    <LinearLayout
        android:id="@+id/widget_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <!-- Main Card Body (Header, Progress Bar, Subtext) -->
        <LinearLayout
            android:id="@+id/widget_item_main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Icon on left, Title with Time Left just below it in center, Action buttons on right (Requirement 8) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_item_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍔"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_item_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Event Title"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_item_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 days left"
                        android:textColor="#FB923C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <!-- Notification Button (immediately pushes persistent notification) -->
                <ImageButton
                    android:id="@+id/widget_item_btn_notify"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_widget_notification"
                    android:scaleType="centerInside"
                    android:contentDescription="Pin note to notification" />

                <!-- Copy Button (copies event body directly to clipboard) -->
                <ImageButton
                    android:id="@+id/widget_item_btn_copy"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="2dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_widget_copy"
                    android:scaleType="centerInside"
                    android:contentDescription="Copy event text" />

                <!-- Dropdown Button (shown only when event has content) -->
                <ImageButton
                    android:id="@+id/widget_item_btn_dropdown"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="2dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_widget_chevron_down"
                    android:scaleType="centerInside"
                    android:contentDescription="Expand content" />
            </LinearLayout>

            <!-- Row 2: Video Player Seek-bar Progress Indicator -->
            <ImageView
                android:id="@+id/widget_item_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitXY"
                android:contentDescription="Progress Seek Bar" />

            <!-- Row 3: Subtext (Dates / elapsed %) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_item_subtext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Expires Sep 10"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_item_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="63%"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dropdown Box (revealed when expanded by user) -->
        <LinearLayout
            android:id="@+id/widget_item_dropdown_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="@drawable/widget_dropdown_bg"
            android:gravity="center_vertical">

            <!-- Small square image on the left -->
            <ImageView
                android:id="@+id/widget_item_dropdown_image"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Attached image" />

            <!-- Text / URL content on the right -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_item_dropdown_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_item_dropdown_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#60A5FA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
